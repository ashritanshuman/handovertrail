# HandoverTrail Environment Configuration

# Anthropic API Key (required for live LLM extraction service; fallback to synthetic seed cache when empty)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Anthropic Model (default: claude-sonnet-5-5 or claude-3-5-sonnet-20241022)
LLM_MODEL=claude-sonnet-5-5

# Database URL (SQLite file database)
DATABASE_URL=sqlite:///./handovertrail.db

# Server Configuration (Port 8080 used to avoid conflicts with common local services)
PORT=8080
HOST=0.0.0.0
ENVIRONMENT=development

# Frontend distribution directory for production single-service serving
FRONTEND_DIR=frontend/dist

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
