# HandoverTrail Environment Configuration

# Google Gemini API Key (optional; when absent or rate-limited, extraction falls back to deterministic cache)
GEMINI_API_KEY=

# Gemini Model (default: current Gemini Flash model)
LLM_MODEL=gemini-2.5-flash

# Database URL (SQLite file database with WAL journal mode)
DATABASE_URL=sqlite:///./handovertrail.db

# Server Configuration (Port 8080 used for single-service deployment)
PORT=8080
HOST=0.0.0.0
ENVIRONMENT=development

# Frontend distribution directory for production single-service serving
FRONTEND_DIST=../frontend/dist

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
